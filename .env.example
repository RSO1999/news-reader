# Copy this file to .env in the repository root before running Docker Compose.

# Required for Gemini-powered article context.
# Get a key from https://aistudio.google.com/
STORYSTREAM_GEMINI_API_KEY=replace-with-your-current-gemini-api-key

# Optional backend debug endpoint toggle.
ALLOW_GEMINI_DEBUG=true

# Database settings used by both the Postgres container and the backend container.
POSTGRES_DB=storystream
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

